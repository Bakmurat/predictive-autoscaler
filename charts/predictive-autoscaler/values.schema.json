{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "predictive-autoscaler chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["images", "prometheus", "operator", "forecaster", "training", "networkPolicy", "metrics"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
        "limits": {"type": "object", "additionalProperties": {"type": ["string", "number"]}}
      }
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "matchExpressions": {"type": "array", "items": {"type": "object"}}
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "podSelector": {"$ref": "#/definitions/labelSelector"},
        "ipBlock": {"type": "object", "required": ["cidr"], "properties": {"cidr": {"type": "string"}, "except": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "scheduling": {
      "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
      "tolerations": {"type": "array", "items": {"type": "object"}},
      "affinity": {"type": "object"}
    }
  },
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "forecaster"],
      "properties": {
        "operator": {"$ref": "#/definitions/image"},
        "forecaster": {"$ref": "#/definitions/image"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}}}
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://[^\\s]+$", "description": "The Prometheus-compatible query API base URL (required)."}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "watchNamespaces": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}},
        "forecastLedger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "persistence": {"type": "object", "additionalProperties": false, "properties": {"existingClaim": {"type": "string"}}}
          }
        },
        "resources": {"$ref": "#/definitions/resources"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "nodeSelector": {"$ref": "#/definitions/scheduling/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/scheduling/tolerations"},
        "affinity": {"$ref": "#/definitions/scheduling/affinity"}
      }
    },
    "forecaster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {"$ref": "#/definitions/resources"},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {"type": "string"},
            "storageClass": {"type": "string"},
            "size": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)$"},
            "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"], "description": "Never ReadWriteOncePod: the trainer mounts the forecaster's claim."},
            "retain": {"type": "boolean"}
          }
        },
        "tmpSizeLimit": {"type": "string", "pattern": "^[0-9]+(Mi|Gi)$"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "nodeSelector": {"$ref": "#/definitions/scheduling/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/scheduling/tolerations"},
        "affinity": {"$ref": "#/definitions/scheduling/affinity"}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "name", "schedule"],
            "properties": {
              "namespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
              "name": {"type": "string", "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?$", "maxLength": 253},
              "schedule": {"type": "string", "minLength": 9}
            }
          }
        },
        "hours": {"type": "integer", "minimum": 24},
        "epochs": {"type": ["integer", "null"], "minimum": 1},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/scheduling/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/scheduling/tolerations"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"namespaceSelector": {"$ref": "#/definitions/labelSelector"}, "podSelector": {"$ref": "#/definitions/labelSelector"}}
        },
        "kubeAPI": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"cidrs": {"type": "array", "items": {"type": "string"}}, "ports": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/port"}}}
        },
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
            "podSelector": {"$ref": "#/definitions/labelSelector"},
            "ipBlocks": {"type": "array", "items": {"type": "string"}},
            "ports": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/port"}}
          }
        },
        "metricsFrom": {"type": "array", "items": {"$ref": "#/definitions/peer"}}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string"}}},
        "vmServiceScrape": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string"}}}
      }
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "global": {"type": "object"}
  }
}
