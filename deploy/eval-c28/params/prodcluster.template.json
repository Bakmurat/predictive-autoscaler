{
 "schema": "c28-params/v1",
 "run_id": "<run id, e.g. c28-r1>",
 "namespace": "demo",
 "control_namespace": "pa-eval-system",
 "image": "<registry>/c28-fixture@sha256:<digest of the pushed image>",
 "c0_rps": "<measured c0 (section 3), a number>",
 "nodes": {
  "workload": "<W node name from the fresh inventory>",
  "support": "<S node name>"
 },
 "reservation": {
  "taint_key": "c28.devkuban.com/reserved",
  "taint_value": "<run id>",
  "role_label": "c28.devkuban.com/role"
 },
 "fixture": {
  "work_iterations": "<tuned once so twelve replicas fit W>",
  "response_bytes": 512,
  "max_inflight": "<bounded>",
  "max_queue": "<bounded>",
  "queue_timeout_seconds": 1.5,
  "cpu_request": "<calibrated and reviewed (section 3), identical for every arm; never lowered to fit the residency budget>",
  "cpu_limit": "<calibrated and reviewed, same for every arm>",
  "memory_request": "<calibrated and reviewed, same for every arm>",
  "memory_limit": "<calibrated and reviewed, same for every arm>"
 },
 "ingress": {
  "cpu_request": "<sized for 120 % of maximum planned arrivals>",
  "cpu_limit": "<>",
  "memory_request": "<>",
  "memory_limit": "<>"
 },
 "proxy": {
  "cpu_request": "50m",
  "cpu_limit": "200m",
  "memory_request": "32Mi",
  "memory_limit": "64Mi"
 },
 "hpa_cpu_target_percent": "<selected on development traces, seeds 101-105>",
 "keda": {
  "server_address": "http://c28-metrics-route.pa-eval-system.svc:8481/select/0/prometheus",
  "polling_interval_seconds": 15
 },
 "routes": {
  "metrics_upstream": "<host:port of the cluster VictoriaMetrics query API (vmselect)>",
  "metrics_query_path": "/select/0/prometheus",
  "forecast_upstream": "<host:port of the evaluation forecaster>"
 },
 "priority_class": "c28-fixture",
 "quota": {
  "name": "c28-fixture-quota",
  "pods_normal": 64
 },
 "scrape": "<VMPodScrape | PodMonitor | annotations, per the observer>",
 "release": "<evaluation Helm release name, e.g. pa-eval>",
 "release_network_policies": "<true when the release enforces NetworkPolicies>",
 "residency": {
  "workload": {
   "allocatable": {
    "cpu": "<W allocatable CPU from the fresh dated inventory, e.g. 4000m>",
    "memory": "<W allocatable memory, e.g. 7.75Gi>"
   },
   "system_requests": {
    "cpu": "<summed CPU requests of the system pods that stay on W (DaemonSets, agents)>",
    "memory": "<their summed memory requests>"
   }
  },
  "support": {
   "allocatable": {
    "cpu": "<S allocatable CPU>",
    "memory": "<S allocatable memory>"
   },
   "system_requests": {
    "cpu": "<summed CPU requests of the system pods that stay on S>",
    "memory": "<their summed memory requests>"
   }
  },
  "overlap_pods": 2,
  "idle_arm_replicas": 2,
  "operator": {
   "cpu_request": "100m",
   "memory_request": "128Mi"
  },
  "forecaster": {
   "cpu_request": "1",
   "memory_request": "512Mi"
  },
  "generator": {
   "concurrent": 1,
   "cpu_request": "500m",
   "memory_request": "256Mi"
  },
  "support_extra": "<every other evaluation pod on S (recorder, adapters) as [{name, replicas, cpu_request, memory_request}], or [] when none>"
 }
}
