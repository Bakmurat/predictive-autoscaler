############################
# The statistical forecasting service (forecast contract v2): no TensorFlow, Keras or CUDA, and no api/main.py.
# Build from ml-engine/: docker build -f Dockerfile.statistical --build-arg SOURCE_TREE=$(git rev-parse HEAD) -t <ref> .
# A lab EVALUATION build (C2.8; the only kind that honours a lab qualification) is made only from a pushed commit by
# hack/build-statistical-evaluation.sh <commit> <ref> (EVALUATION_BUILD=true, verified against the commit); a release
# image is built with the default (false) and refuses every lab qualification.
# Check: python3 ../hack/sbom-check-statistical.py --image <ref>
############################
FROM python:3.12-slim AS builder
WORKDIR /app
COPY requirements-statistical.txt .
RUN pip install --no-cache-dir --no-deps --only-binary=:all: -r requirements-statistical.txt

# The build record: an evaluation build must come from hack/build-statistical-evaluation.sh (the context is
# `git archive <commit>` plus its manifest); anything dirty or mismatched fails here. Not part of the final image.
FROM python:3.12-slim AS verify
ARG SOURCE_TREE=unknown
ARG EVALUATION_BUILD=false
COPY . /ctx
RUN python /ctx/build_record.py /ctx "$SOURCE_TREE" "$EVALUATION_BUILD" /build-info.json

FROM python:3.12-slim
WORKDIR /app
COPY --from=builder /usr/local /usr/local
# Only the modules the statistical service imports (listed explicitly: the legacy service is never in this image).
COPY api/admission.py api/auth.py api/identity.py api/serve.py api/statistical.py ./api/
COPY data/bounded_http.py data/history.py ./data/
COPY forecasting/ ./forecasting/
# A fixed numeric non-root user (the chart runs it as 10001 with a read-only root filesystem; writable: /state, /tmp).
RUN useradd --uid 10001 --user-group --create-home --shell /usr/sbin/nologin app && chown -R 10001:10001 /app
# The build record (root-owned, read-only), proven in the verify stage: which source tree, and whether this is a lab
# evaluation build (then every copied file is checked against that commit; see build_record.py).
COPY --from=verify /build-info.json /app/build-info.json
RUN chown root:root /app/build-info.json && chmod 0444 /app/build-info.json
ARG SOURCE_TREE=unknown
ARG EVALUATION_BUILD=false
LABEL org.opencontainers.image.revision=$SOURCE_TREE io.devkuban.predictive-autoscaler.evaluation-build=$EVALUATION_BUILD
USER 10001:10001
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import os,ssl,urllib.request; tls=bool(os.getenv('FORECASTER_TLS_CERT')); port=os.getenv('FORECASTER_PORT', '8443' if tls else '8000'); urllib.request.urlopen(('https' if tls else 'http')+'://localhost:'+port+'/health', timeout=4, context=ssl._create_unverified_context() if tls else None)" || exit 1
CMD ["python", "-m", "api.serve", "statistical"]
